{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'owner' || (auth.token.email != null && auth.token.email.matches(/.*(admin|owner).*/)))",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'owner' || (auth.token.email != null && auth.token.email.matches(/.*(admin|owner).*/)))",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'owner' || (auth.token.email != null && auth.token.email.matches(/.*(admin|owner).*/)))",
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() == 'admin' || newData.val() == 'owner' || newData.val() == 'employee' || newData.val() == 'customer')"
        }
      }
    },
    "notifications": {
      "customers": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'owner' || root.child('users').child(auth.uid).child('role').val() == 'employee')",
          ".write": "auth != null"
        }
      },
      "store": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "chats": {
      "$customerId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "sale_deals": {
      ".read": true,
      ".write": "auth != null"
    },
    ".read": false,
    ".write": false
  }
}
