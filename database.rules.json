      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null",
      "customers": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "store": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "orders": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$customerId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "sale_deals": {
      ".read": true,
      ".write": "auth != null"
    },
    "delivery_tracking": {
      ".read": "auth != null",
